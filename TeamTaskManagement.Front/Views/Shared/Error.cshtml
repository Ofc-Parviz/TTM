@{
    ViewData["Title"] = "خطا";

    int statusCode = Context.Response.StatusCode;
    bool isNotFound = statusCode == 404;

    string titleText = isNotFound ? "مسیر پیدا نشد" : "خطای غیرمنتظره در سامانه";
    string messageText = isNotFound
        ? "نشانی درخواستی وجود ندارد یا جابه‌جا شده است."
        : "در پردازش درخواست شما خطایی رخ داده و عملیات کامل نشد. لطفاً کمی بعد دوباره تلاش کنید.";
    string iconClass = isNotFound ? "bi-compass-fill" : "bi-exclamation-triangle-fill";
    string severityLabel = isNotFound ? "هشدار مسیر" : "خطای سیستمی";
    string traceId = Context.TraceIdentifier;
}

@section Styles {
    <style>
        .ttm-err-card {
            position: relative;
            max-width: 36rem;
            margin: 2rem auto 2rem;
            background: radial-gradient(120% 60% at 50% 0%, rgba(220, 38, 38, .08), transparent 60%), #fff;
            border: 1px solid var(--ttm-border);
            border-top: 4px solid var(--ttm-danger);
            border-radius: 14px;
            box-shadow: 0 8px 24px rgba(220, 38, 38, .08);
            padding: 2.25rem 1.5rem 2rem;
            text-align: center;
            overflow: hidden;
        }

        html[data-theme="dark"] .ttm-err-card {
            background: radial-gradient(120% 60% at 50% 0%, rgba(248, 113, 113, .12), transparent 60%), #1A1A1A;
            box-shadow: none;
        }

        .ttm-err-badge {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            font-size: .72rem;
            font-weight: 700;
            color: var(--ttm-danger);
            background: rgba(220, 38, 38, .1);
            border: 1px solid rgba(220, 38, 38, .3);
            border-radius: 999px;
            padding: .25rem .8rem;
            margin-bottom: 1.25rem;
        }

        html[data-theme="dark"] .ttm-err-badge {
            color: #F87171;
            background: rgba(248, 113, 113, .12);
            border-color: rgba(248, 113, 113, .35);
        }

        .ttm-err-icon {
            width: 76px;
            height: 76px;
            margin: 0 auto 1rem;
            border-radius: 50%;
            background: var(--ttm-danger);
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 2.1rem;
            box-shadow: 0 10px 24px rgba(220, 38, 38, .3);
        }

        html[data-theme="dark"] .ttm-err-icon {
            background: #DC2626;
            box-shadow: 0 10px 24px rgba(248, 113, 113, .25);
        }

        .ttm-err-code {
            font-size: 3.25rem;
            font-weight: 800;
            line-height: 1;
            letter-spacing: -.02em;
            color: var(--ttm-danger);
            margin-bottom: .6rem;
            direction: ltr;
        }

        html[data-theme="dark"] .ttm-err-code {
            color: #F87171;
        }

        .ttm-err-title {
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--ttm-text);
            margin-bottom: .6rem;
        }

        .ttm-err-message {
            font-size: .92rem;
            line-height: 1.9;
            color: var(--ttm-muted);
            margin-bottom: 1.25rem;
        }

        .ttm-err-alert {
            display: flex;
            align-items: flex-start;
            gap: .65rem;
            text-align: start;
            background: rgba(220, 38, 38, .06);
            border: 1px solid rgba(220, 38, 38, .2);
            border-inline-start: 4px solid var(--ttm-danger);
            border-radius: 8px;
            padding: .8rem 1rem;
            font-size: .85rem;
            line-height: 1.8;
            color: var(--ttm-text);
            margin-bottom: 1.5rem;
        }

            .ttm-err-alert > i {
                color: var(--ttm-danger);
                font-size: 1.1rem;
                margin-top: .15rem;
            }

        html[data-theme="dark"] .ttm-err-alert {
            background: rgba(248, 113, 113, .08);
            border-color: rgba(248, 113, 113, .3);
        }

            html[data-theme="dark"] .ttm-err-alert > i {
                color: #F87171;
            }

        .ttm-err-actions {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: .6rem;
        }

        .ttm-err-trace {
            display: inline-block;
            margin-top: 1.5rem;
            padding: .3rem .7rem;
            border-radius: 6px;
            background: #F5F3F0;
            border: 1px solid var(--ttm-border);
            color: var(--ttm-muted);
            font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
            font-size: .72rem;
            direction: ltr;
        }

        html[data-theme="dark"] .ttm-err-trace {
            background: #252525;
        }

        .ttm-err-btn-home {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            background: var(--ttm-danger);
            border: 1px solid var(--ttm-danger);
            color: #fff;
            font-weight: 600;
            border-radius: 8px;
            padding: .5rem 1.1rem;
            text-decoration: none;
            box-shadow: 0 6px 16px rgba(220, 38, 38, .25);
            transition: background .2s, box-shadow .2s, transform .15s;
        }

            .ttm-err-btn-home:hover,
            .ttm-err-btn-home:focus-visible {
                background: #B91C1C;
                border-color: #B91C1C;
                color: #fff;
                box-shadow: 0 10px 24px rgba(220, 38, 38, .35);
                transform: translateY(-1px);
            }

        html[data-theme="dark"] .ttm-err-btn-home {
            background: #DC2626;
            border-color: #DC2626;
            box-shadow: 0 6px 16px rgba(248, 113, 113, .2);
        }

            html[data-theme="dark"] .ttm-err-btn-home:hover,
            html[data-theme="dark"] .ttm-err-btn-home:focus-visible {
                background: #EF4444;
                border-color: #EF4444;
            }

        .form-text {
            color: var(--ttm-muted) !important;
        }

        @@media (max-width: 767px) {
            .ttm-err-card {
                margin-bottom: 2.5rem;
            }
        }
    </style>
}
<div class="ttm-err-card">

    <span class="ttm-err-badge">
        <i class="bi bi-exclamation-octagon-fill"></i> @severityLabel
    </span>

    <div class="ttm-err-icon">
        <i class="bi @iconClass"></i>
    </div>

    <div class="ttm-err-code">@statusCode</div>
    <h1 class="ttm-err-title">@titleText</h1>
    <p class="ttm-err-message">@messageText</p>

    <div class="ttm-err-alert" role="alert">
        <i class="bi bi-shield-exclamation"></i>
        <div>
            اگر این خطا دوباره رخ داد، کد پیگیری زیر را به همراه شرح کاری که انجام می‌دادید گزارش کنید تا بررسی آن سریع‌تر انجام شود.
        </div>
    </div>

    <div class="ttm-err-actions">
        <a href="/" class="ttm-err-btn-home">
            <i class="bi bi-house"></i> صفحه اصلی
        </a>
    </div>

    @if (!string.IsNullOrEmpty(traceId)) {
        <div>
            <span class="ttm-err-trace">Trace Id: @traceId</span>
        </div>
    }
</div>