@{
    ViewData["Title"] = "مستندات";
    var isAuth = User?.Identity?.IsAuthenticated ?? false;
    var ctaHref = isAuth ? "/Teams" : "/SignIn";
    var ctaText = isAuth ? "رفتن به تیم‌ها" : "ورود / ثبت‌نام";
    string repoUrl = "https://github.com/ofc-parviz/ttm";
}

@section Styles {
    <style>
        .ttm-doc-layout {
            align-items: flex-start;
        }

        .ttm-doc-aside {
            align-self: flex-start;
        }

        .ttm-doc-aside {
            color-scheme: light;
        }

        html[data-theme="dark"] .ttm-doc-aside {
            color-scheme: dark;
        }

        @@media (min-width: 992px) {
            .ttm-doc-aside {
                position: sticky;
                top: calc(var(--ttm-nav-h) + 1.5rem);
                max-height: calc(100vh - var(--ttm-nav-h) - 3rem);
                overflow-y: auto;
                scrollbar-width: thin;
            }
        }

        .ttm-doc-nav-audience {
            font-size: .72rem;
            font-weight: 700;
            letter-spacing: .03em;
            color: var(--ttm-primary);
            margin: 1.25rem 0 .35rem;
            padding-inline-start: .75rem;
        }

            .ttm-doc-nav-audience:first-child {
                margin-top: 0;
            }

        .ttm-doc-nav-link {
            display: block;
            padding: .3rem .75rem;
            color: var(--ttm-text);
            text-decoration: none;
            font-size: .85rem;
            border-inline-start: 2px solid transparent;
            transition: color .15s, border-color .15s, background .15s;
        }

            .ttm-doc-nav-link:hover {
                color: var(--ttm-primary);
                background: rgba(91, 33, 182, .06);
            }

            .ttm-doc-nav-link.is-active {
                color: var(--ttm-primary);
                border-inline-start-color: var(--ttm-primary);
                font-weight: 600;
            }

        html[data-theme="dark"] .ttm-doc-nav-link:hover,
        html[data-theme="dark"] .ttm-doc-nav-link.is-active {
            color: #A78BFA;
            background: rgba(149, 101, 224, .12);
        }

        @@media (max-width: 991px) {
            .ttm-doc-aside {
                position: sticky;
                top: var(--ttm-nav-h);
                margin-top: -1.5rem;
                z-index: 1020;
                background: var(--ttm-surface);
                overflow-x: auto;
                scrollbar-width: none;
                border-bottom: 1px solid var(--ttm-border);
                box-shadow: 0 4px 12px rgba(0, 0, 0, .06);
                padding-top: .5rem;
                padding-bottom: .5rem;
                width: 100vw;
                margin-inline: calc(50% - 50vw);
                padding-inline: .75rem;
            }

            .ttm-doc-part,
            .ttm-doc-section {
                scroll-margin-top: calc(var(--ttm-nav-h) + 4.5rem);
            }

                .ttm-doc-aside::-webkit-scrollbar {
                    display: none;
                }

            .ttm-doc-nav {
                display: flex;
                gap: .25rem;
                white-space: nowrap;
            }

            .ttm-doc-nav-audience {
                display: none;
            }

            .ttm-doc-nav-link {
                border-inline-start: none;
                border-radius: 999px;
                padding: .3rem .9rem;
            }

                .ttm-doc-nav-link.is-active {
                    background: rgba(91, 33, 182, .1);
                }

                .ttm-doc-nav-link.is-active {
                    font-weight: 400;
                }

            .ttm-doc-aside {
                transform: translateZ(0);
                overscroll-behavior-x: contain;
            }

            .ttm-doc-hero{
            
                margin-top: 1.5rem;
            }
        }

        @@media (max-width: 991px) {
            html[data-theme="dark"] .ttm-doc-aside {
                box-shadow: 0 4px 12px rgba(0, 0, 0, .45);
            }
        }

        .ttm-doc-hero {
            background: var(--ttm-primary);
            color: #fff;
            border-radius: 12px;
        }

        html[data-theme="dark"] .ttm-doc-hero {
            background: #2D1B4E;
        }

        .ttm-doc-hero .btn {
            background: #fff;
            color: var(--ttm-primary);
            border: none;
            font-weight: 600;
        }

            .ttm-doc-hero .btn:hover {
                background: #F3E8FF;
                color: var(--ttm-primary-dark);
            }

        html[data-theme="dark"] .ttm-doc-hero .btn {
            background: var(--ttm-primary);
            color: #fff;
        }

        .ttm-audience-card {
            display: block;
            height: 100%;
            background: #fff;
            border: 1px solid var(--ttm-border);
            border-radius: 10px;
            padding: 1rem 1.1rem;
            text-decoration: none;
            color: var(--ttm-text);
            transition: border-color .2s, box-shadow .2s;
        }

            .ttm-audience-card:hover {
                border-color: var(--ttm-primary);
                box-shadow: 0 6px 18px rgba(91, 33, 182, .15);
                color: var(--ttm-text);
            }

        html[data-theme="dark"] .ttm-audience-card {
            background: #1A1A1A;
        }

        .ttm-audience-icon {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: rgba(91, 33, 182, .1);
            color: var(--ttm-primary);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: .6rem;
        }

        html[data-theme="dark"] .ttm-audience-icon {
            background: rgba(149, 101, 224, .18);
            color: #A78BFA;
        }

        .ttm-doc-part {
            display: flex;
            align-items: center;
            gap: .75rem;
            padding: 1rem 0 .25rem;
            scroll-margin-top: calc(var(--ttm-nav-h) + 1.5rem);
        }

        .ttm-doc-part-label {
            font-size: .72rem;
            font-weight: 700;
            color: #fff;
            background: var(--ttm-primary);
            border-radius: 4px;
            padding: .15rem .5rem;
            white-space: nowrap;
        }

        .ttm-doc-part h2 {
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--ttm-text);
            margin: 0;
        }

        .ttm-doc-part-rule {
            border-top: 1px solid var(--ttm-border);
            margin: .75rem 0 0;
        }

        .ttm-doc-section {
            background: #fff;
            border: 1px solid var(--ttm-border);
            border-radius: 10px;
            padding: 1.5rem;
            margin-top: 1.25rem;
            scroll-margin-top: calc(var(--ttm-nav-h) + 1.5rem);
        }

        html[data-theme="dark"] .ttm-doc-section {
            background: #1A1A1A;
        }

        .ttm-doc-section h3 {
            font-size: 1.02rem;
            font-weight: 700;
            color: var(--ttm-text);
            margin-bottom: .9rem;
        }

        .ttm-doc-section h4 {
            font-size: .92rem;
            font-weight: 600;
            color: var(--ttm-text);
            margin: 1.25rem 0 .5rem;
        }

        .ttm-doc-section p,
        .ttm-doc-section li {
            color: var(--ttm-text);
            line-height: 1.85;
            font-size: .92rem;
        }

        .ttm-doc-p-muted {
            color: var(--ttm-muted) !important;
        }

        .ttm-doc-code {
            font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
            font-size: .82rem;
            background: #F5F3F0;
            color: var(--ttm-text);
            border: 1px solid var(--ttm-border);
            border-radius: 6px;
            padding: .1rem .4rem;
            direction: ltr;
            unicode-bidi: isolate;
        }

        html[data-theme="dark"] .ttm-doc-code {
            background: #252525;
        }

        .ttm-doc-pre {
            direction: ltr;
            text-align: left;
            font-size: .82rem;
            background: #F5F3F0;
            border: 1px solid var(--ttm-border);
            border-radius: 8px;
            padding: .9rem 1rem;
            margin: .5rem 0 1rem;
            overflow-x: auto;
            color: var(--ttm-text);
            white-space: pre;
        }

        .ttm-doc-pre {
            color-scheme: light;
        }

        html[data-theme="dark"] .ttm-doc-pre {
            background: #141414;
            color-scheme: dark;
        }

        .ttm-doc-table {
            font-size: .85rem;
            color: var(--ttm-text);
            --bs-table-color: var(--ttm-text);
            --bs-table-bg: transparent;
            --bs-table-border-color: var(--ttm-border);
            border-color: var(--ttm-border);
        }

            .ttm-doc-table th {
                font-weight: 600;
                color: var(--ttm-muted);
                font-size: .78rem;
                border-bottom-color: var(--ttm-border);
                white-space: nowrap;
            }

            .ttm-doc-table td {
                border-color: var(--ttm-border);
                vertical-align: middle;
            }

            .ttm-doc-table .ttm-group-row td {
                background: #F9F5FF;
                color: var(--ttm-primary);
                font-weight: 600;
                font-size: .8rem;
            }

        html[data-theme="dark"] .ttm-doc-table .ttm-group-row td {
            background: #2D1B4E;
            color: #A78BFA;
        }

        .ttm-method {
            font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
            font-size: .72rem;
            font-weight: 700;
            padding: .15rem .45rem;
            border-radius: 4px;
            display: inline-block;
            min-width: 58px;
            text-align: center;
        }

        .ttm-method-get {
            background: #DCFCE7;
            color: #166534;
        }

        .ttm-method-post {
            background: #DBEAFE;
            color: #1E40AF;
        }

        .ttm-method-put {
            background: #FEF3C7;
            color: #92400E;
        }

        .ttm-method-delete {
            background: #FEE2E2;
            color: #991B1B;
        }

        html[data-theme="dark"] .ttm-method-get {
            background: #14532D;
            color: #BBF7D0;
        }

        html[data-theme="dark"] .ttm-method-post {
            background: #1E3A8A;
            color: #BFDBFE;
        }

        html[data-theme="dark"] .ttm-method-put {
            background: #78350F;
            color: #FDE68A;
        }

        html[data-theme="dark"] .ttm-method-delete {
            background: #7F1D1D;
            color: #FECACA;
        }

        .ttm-doc-note {
            border-inline-start: 3px solid var(--ttm-primary);
            background: rgba(91, 33, 182, .05);
            border-radius: 0 8px 8px 0;
            padding: .75rem 1rem;
            font-size: .88rem;
            margin: 1rem 0;
            color: var(--ttm-text);
        }

            .ttm-doc-note.is-warning {
                border-inline-start-color: var(--ttm-danger);
                background: rgba(220, 38, 38, .05);
            }

        html[data-theme="dark"] .ttm-doc-note {
            background: rgba(149, 101, 224, .1);
        }

            html[data-theme="dark"] .ttm-doc-note.is-warning {
                background: rgba(248, 113, 113, .08);
            }

        .ttm-doc-steps {
            counter-reset: step;
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .ttm-doc-steps li {
                counter-increment: step;
                display: flex;
                gap: .85rem;
                padding: .8rem 0;
                border-bottom: 1px solid var(--ttm-border);
            }

                .ttm-doc-steps li:last-child {
                    border-bottom: none;
                    padding-bottom: 0;
                }

                .ttm-doc-steps li::before {
                    content: counter(step);
                    width: 26px;
                    height: 26px;
                    border-radius: 6px;
                    background: var(--ttm-primary);
                    color: #fff;
                    font-size: .8rem;
                    font-weight: 700;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    flex-shrink: 0;
                }

        .ttm-doc-qa {
            padding: .9rem 0;
            border-bottom: 1px solid var(--ttm-border);
        }

            .ttm-doc-qa:last-child {
                border-bottom: none;
                padding-bottom: 0;
            }

            .ttm-doc-qa h4 {
                margin-top: 0;
                font-size: .92rem;
            }

            .ttm-doc-qa p {
                margin: 0;
                font-size: .88rem;
                color: var(--ttm-muted) !important;
            }

        .ttm-doc-link {
            color: var(--ttm-primary);
        }

        .ttm-doc-footer {
            border-top-color: var(--ttm-border) !important;
        }

        .ttm-doc-footer {
            gap: .5rem;
        }

        @@media (max-width: 767px) {
            .ttm-doc-footer {
                gap: 1.25rem;
                padding-bottom: 1.25rem;
            }
        }

        .btn-primary {
        background-color: var(--ttm-primary);
        border-color: var(--ttm-primary);
        transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }

        .btn-primary:hover,
        .btn-primary:focus {
            background-color: var(--ttm-primary-dark);
            border-color: var(--ttm-primary-dark);
            box-shadow: 0 8px 24px rgba(91, 33, 182, 0.25);
        }

        .btn-primary i,
        .btn-outline-primary i {
            vertical-align: -1px;
        }

    html[data-theme="dark"] .btn-primary:hover,
    html[data-theme="dark"] .btn-primary:focus {
        box-shadow: 0 8px 24px rgba(149, 101, 224, 0.5);
    }

    .btn-outline-primary {
        color: var(--ttm-primary);
        border-color: var(--ttm-primary);
        transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

        .btn-outline-primary:hover {
            background-color: var(--ttm-primary);
            border-color: var(--ttm-primary);
            color: #fff;
            box-shadow: 0 8px 24px rgba(91, 33, 182, 0.25);
        }

    html[data-theme="dark"] .btn-outline-primary:hover {
        box-shadow: 0 8px 24px rgba(149, 101, 224, 0.5);
    }
    </style>
}

<div class="row g-4 ttm-doc-layout">

    @* ── Sidebar ── *@
    <aside class="col-12 col-lg-3 ttm-doc-aside">
        <nav class="ttm-doc-nav-wrap" aria-label="فهرست مستندات">
            <div class="ttm-doc-nav">
                <div class="ttm-doc-nav-audience">کاربران</div>
                <a href="#users-start" class="ttm-doc-nav-link">شروع کار</a>
                <a href="#users-concepts" class="ttm-doc-nav-link">مفاهیم و نقش‌ها</a>
                <a href="#users-teams" class="ttm-doc-nav-link">تیم و دعوت</a>
                <a href="#users-tasks" class="ttm-doc-nav-link">وظایف</a>
                <a href="#users-faq" class="ttm-doc-nav-link">پرسش‌های متداول</a>

                <div class="ttm-doc-nav-audience">توسعه‌دهندگان</div>
                <a href="#dev-setup" class="ttm-doc-nav-link">اجرای محلی</a>
                <a href="#dev-structure" class="ttm-doc-nav-link">سلوشن و معماری</a>
                <a href="#dev-domain" class="ttm-doc-nav-link">مدل دامین</a>
                <a href="#dev-auth" class="ttm-doc-nav-link">احراز هویت</a>
                <a href="#dev-tests" class="ttm-doc-nav-link">تست‌ها</a>
                <a href="#dev-api" class="ttm-doc-nav-link">مرجع API</a>

                <div class="ttm-doc-nav-audience">بررسی فنی</div>
                <a href="#tech-decisions" class="ttm-doc-nav-link">تصمیمات معماری</a>
                <a href="#tech-invariants" class="ttm-doc-nav-link">قوانین و تغییر وضعیت‌ها</a>
                <a href="#tech-patterns" class="ttm-doc-nav-link">الگوها و قراردادها</a>
            </div>
        </nav>
    </aside>

    <div class="col-12 col-lg-9">

        @* ── Hero ── *@
        <header class="ttm-doc-hero p-4 p-md-5 mb-4">
            <div class="small mb-2" style="color: rgba(255,255,255,.75);">
                <a href="/" style="color: rgba(255,255,255,.75);">خانه</a>
                <span class="mx-1">/</span>
                <span>مستندات</span>
            </div>
            <h1 class="h3 fw-bold mb-2">مستندات مدیریت وظایف تیم</h1>
            <p class="mb-4" style="color: rgba(255,255,255,.85); line-height: 1.9;">
                این صفحه برای سه گروه نوشته شده است: کاربران سامانه، توسعه‌دهندگانی که می‌خواهند پروژه را اجرا یا بررسی کنند،
                و ارزیابان فنی که مایلند تصمیمات معماری را بشناسند.
            </p>
            <a href="@ctaHref" class="btn btn-sm px-3">
                @ctaText
            </a>
        </header>

        @* ── Audience entry points ── *@
        <div class="row g-3 mb-2">
            <div class="col-12 col-md-4">
                <a href="#users" class="ttm-audience-card">
                    <span class="ttm-audience-icon"><i class="bi bi-person"></i></span>
                    <div class="fw-semibold mb-1">کاربران</div>
                    <div class="small ttm-doc-p-muted">استفاده از سامانه، ساخت تیم، دعوت اعضا و پیگیری وظایف</div>
                </a>
            </div>
            <div class="col-12 col-md-4">
                <a href="#developers" class="ttm-audience-card">
                    <span class="ttm-audience-icon"><i class="bi bi-code-slash"></i></span>
                    <div class="fw-semibold mb-1">توسعه‌دهندگان</div>
                    <div class="small ttm-doc-p-muted">اجرای محلی، ساختار سلوشن، مدل دامین و مرجع API</div>
                </a>
            </div>
            <div class="col-12 col-md-4">
                <a href="#technical" class="ttm-audience-card">
                    <span class="ttm-audience-icon"><i class="bi bi-diagram-3"></i></span>
                    <div class="fw-semibold mb-1">بررسی فنی</div>
                    <div class="small ttm-doc-p-muted">تصمیمات معماری، قواعد کسب‌وکار و محدودیت‌های فعلی</div>
                </a>
            </div>
        </div>

        <article>

            @* ════════════════ کاربران ════════════════ *@
            <div class="ttm-doc-part mt-4" id="users">
                <span class="ttm-doc-part-label">بخش ۱</span>
                <h2>راهنمای کاربران</h2>
            </div>
            <hr class="ttm-doc-part-rule" />

            <section class="ttm-doc-section" id="users-start">
                <h3>شروع کار</h3>
                <p>سامانه مدیریت وظایف تیم برای گروه‌هایی طراحی شده که می‌خواهند کارهای مشترک را در یک جا ثبت کنند، میان اعضا تقسیم کنند و وضعیت هر وظیفه را تا پایان دنبال کنند. برای استفاده از نسخه وب نیازی به نصب نرم‌افزار نیست.</p>

                <ol class="ttm-doc-steps mt-3">
                    <li>
                        <div>
                            <strong>ثبت‌نام یا ورود</strong>
                            <p class="small mb-0 mt-1 ttm-doc-p-muted">با ایمیل خود حساب بسازید یا وارد شوید. <a class="ttm-doc-link" href="/SignIn">صفحه ورود</a></p>
                        </div>
                    </li>
                    <li>
                        <div>
                            <strong>ساخت تیم</strong>
                            <p class="small mb-0 mt-1 ttm-doc-p-muted">نام و توضیحات تیم را وارد کنید و عنوان نقش خود را مشخص کنید. شما به‌عنوان مالک تیم ثبت می‌شوید. <a class="ttm-doc-link" href="/Teams">تیم‌های من</a></p>
                        </div>
                    </li>
                    <li>
                        <div>
                            <strong>دعوت اعضا</strong>
                            <p class="small mb-0 mt-1 ttm-doc-p-muted">از صفحه جزئیات تیم، کاربران را با ایمیل یا شناسه دعوت کنید. <a class="ttm-doc-link" href="/Invites">دعوت‌ها</a></p>
                        </div>
                    </li>
                    <li>
                        <div>
                            <strong>ایجاد وظیفه و پیگیری</strong>
                            <p class="small mb-0 mt-1 ttm-doc-p-muted">برای یک عضو وظیفه بسازید، در صورت نیاز مهلت تعیین کنید و وضعیت آن را دنبال کنید. <a class="ttm-doc-link" href="/Tasks">وظایف</a></p>
                        </div>
                    </li>
                </ol>
            </section>

            <section class="ttm-doc-section" id="users-concepts">
                <h3>مفاهیم و نقش‌ها</h3>
                <p>هر عضو تیم یک <strong>سطح دسترسی</strong> دارد که مشخص می‌کند چه کارهایی می‌تواند انجام دهد. <strong>عنوان نقش</strong> (مثلاً توسعه‌دهنده فرانت‌اند یا مدیر پروژه) جداست و آزادانه توسط مالک یا سرپرست تعیین می‌شود.</p>

                <div class="table-responsive mt-3">
                    <table class="table ttm-doc-table mb-0">
                        <thead>
                            <tr>
                                <th>عملیات</th>
                                <th class="text-center">مالک</th>
                                <th class="text-center">سرپرست</th>
                                <th class="text-center">کارمند</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td>ویرایش اطلاعات تیم</td><td class="text-center"><i class="bi bi-check-lg text-primary"></i></td><td class="text-center text-muted">—</td><td class="text-center text-muted">—</td></tr>
                            <tr><td>ارسال دعوتنامه</td><td class="text-center"><i class="bi bi-check-lg text-primary"></i></td><td class="text-center"><i class="bi bi-check-lg text-primary"></i></td><td class="text-center text-muted">—</td></tr>
                            <tr><td>تغییر نقش و سطح دسترسی اعضا</td><td class="text-center"><i class="bi bi-check-lg text-primary"></i></td><td class="text-center text-muted">—</td><td class="text-center text-muted">—</td></tr>
                            <tr><td>حذف عضو</td><td class="text-center"><i class="bi bi-check-lg text-primary"></i></td><td class="text-center text-muted">—</td><td class="text-center text-muted">—</td></tr>
                            <tr><td>لغو دعوتنامه</td><td class="text-center"><i class="bi bi-check-lg text-primary"></i></td><td class="text-center"><i class="bi bi-check-lg text-primary"></i></td><td class="text-center text-muted">—</td></tr>
                            <tr><td>ایجاد وظیفه</td><td class="text-center"><i class="bi bi-check-lg text-primary"></i></td><td class="text-center"><i class="bi bi-check-lg text-primary"></i></td><td class="text-center"><i class="bi bi-check-lg text-primary"></i></td></tr>
                            <tr><td>انجام وظایف محول‌شده</td><td class="text-center"><i class="bi bi-check-lg text-primary"></i></td><td class="text-center"><i class="bi bi-check-lg text-primary"></i></td><td class="text-center"><i class="bi bi-check-lg text-primary"></i></td></tr>
                            <tr><td>ترک تیم</td><td class="text-center text-muted">—</td><td class="text-center"><i class="bi bi-check-lg text-primary"></i></td><td class="text-center"><i class="bi bi-check-lg text-primary"></i></td></tr>
                        </tbody>
                    </table>
                </div>
                <ul class="small mt-3 mb-0">
                    <li>سرپرست فقط می‌تواند دعوتنامه با نقش «کارمند» بفرستد.</li>
                    <li>سرپرست فقط دعوتنامه‌هایی را که خودش فرستاده لغو می‌کند؛ مالک هر دعوتنامه‌ای را می‌تواند لغو کند.</li>
                    <li>کارمند فقط می‌تواند برای خودش وظیفه بسازد. هیچ‌کس نمی‌تواند برای مالک تیم وظیفه بسازد.</li>
                    <li>مالک تیم نمی‌تواند تیم را ترک کند.</li>
                </ul>
            </section>

            <section class="ttm-doc-section" id="users-teams">
                <h3>تیم و دعوت</h3>

                <h4>ارسال دعوتنامه</h4>
                <p>از صفحه جزئیات تیم، دکمه «دعوتنامه» را بزنید. شناسه یا ایمیل کاربر، سطح دسترسی و عنوان نقش را وارد کنید. کاربری که هم‌اکنون عضو فعال تیم است یا پیش‌تر دعوتنامه باز دارد، دعوتنامه تازه نمی‌گیرد. دعوتنامه تا زمان پاسخ کاربر در وضعیت «ارسال‌شده» می‌ماند.</p>

                <h4>پذیرش یا رد دعوت</h4>
                <p>دعوتنامه‌های دریافتی در بخش <a class="ttm-doc-link" href="/Invites">دعوت‌ها</a> نمایش داده می‌شوند. با پذیرش، عضو تیم می‌شوید و سطح دسترسی و عنوان نقش پیشنهادی برای شما ثبت می‌شود. اگر چند دعوتنامه از یک تیم داشته باشید و یکی را بپذیرید، بقیه به‌صورت خودکار لغو می‌شوند.</p>

                <h4>لغو دعوتنامه</h4>
                <p>فرستنده دعوتنامه یا مالک تیم می‌تواند دعوتنامه‌ای را که هنوز پاسخ داده نشده لغو کند.</p>

                <h4>ترک تیم و حذف عضو</h4>
                <p>هر عضوی به جز مالک می‌تواند از صفحه تیم خارج شود. فقط مالک می‌تواند عضو را از تیم حذف کند. عضو خارج‌شده یا حذف‌شده با دعوتنامه تازه می‌تواند دوباره به تیم بپیوندد.</p>
                <div class="ttm-doc-note is-warning">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    حذف عضو قابل بازگشت نیست. برای بازگرداندن او باید دعوتنامه تازه ارسال شود.
                </div>
            </section>

            <section class="ttm-doc-section" id="users-tasks">
                <h3>چرخه وظیفه</h3>
                <p>هر وظیفه دو طرف دارد: <strong>محول‌کننده</strong> یا به عبارت دیگر <strong>مدیر وظیفه</strong> که آن را تعریف می‌کند و نتیجه را بررسی می‌کند، و <strong>مسئول</strong> که کار را انجام می‌دهد. وضعیت فعلی همیشه در صفحه جزئیات وظیفه نمایش داده می‌شود.</p>

                <ol class="ttm-doc-steps mt-3">
                    <li>
                        <div>
                            <strong>ایجاد</strong>
                            <p class="small mb-0 mt-1 ttm-doc-p-muted">سرپرست یا مالک، وظیفه را برای یک عضو یا برای خود می‌سازد. مهلت (ددلاین) اختیاری است و اگر تعیین شود باید در آینده باشد. وظیفه تا زمان واکنش مسئول در وضعیت «در انتظار» است.</p>
                        </div>
                    </li>
                    <li>
                        <div>
                            <strong>شروع</strong>
                            <p class="small mb-0 mt-1 ttm-doc-p-muted">مسئول با آغاز کار(دکمه شروع در صفحه جزئیات وظیفه)، وضعیت را به «در حال انجام» تغییر می‌دهد.</p>
                        </div>
                    </li>
                    <li>
                        <div>
                            <strong>اعلام نتیجه</strong>
                            <p class="small mb-0 mt-1 ttm-doc-p-muted">پس از پایان کار، مسئول موفقیت یا شکست وظیفه را اعلام می‌کند.</p>
                        </div>
                    </li>
                    <li>
                        <div>
                            <strong>بستن یا تلاش مجدد</strong>
                            <p class="small mb-0 mt-1 ttm-doc-p-muted">محول‌کننده نتیجه را بررسی می‌کند. وظیفه را می‌بندد، یا در صورت شکست دستور تلاش مجدد می‌دهد. مسئول می‌تواند دستور را بپذیرد و دوباره کار را انجام دهد، یا آن را رد کند. پس از رد دستور، مالک یا مدیروظیفه می توانند عضو دیگری را مسئول آن وظیفه کنند یا پرونده آن وظیفه را بعنوان شکست خورده ببندند.</p>
                        </div>
                    </li>
                    <li>
                        <div>
                            <strong>تغییر مسئول</strong>
                            <p class="small mb-0 mt-1 ttm-doc-p-muted">محول‌کننده یا مالک می‌تواند وظیفه باز را به عضو دیگری بسپارد. در این حالت وضعیت وظیفه دوباره «در انتظار» می‌شود و مسئول جدید باید آن را شروع کند.</p>
                        </div>
                    </li>
                    <li>
                        <div>
                            <strong>شکست در ددلاین</strong>
                            <p class="small mb-0 mt-1 ttm-doc-p-muted">اگر ددلاین بگذرد و وظیفه هنوز بسته نشده باشد، سامانه آن را به‌صورت خودکار با شکست در ددلاین می‌بندد.</p>
                        </div>
                    </li>
                </ol>

                <div class="mt-4">
                    <a href="/Tasks" class="btn btn-outline-primary btn-sm btn-ttm">
                        <i class="bi bi-check2-square"></i> مشاهده وظایف
                    </a>
                </div>
            </section>

            <section class="ttm-doc-section" id="users-faq">
                <h3>پرسش‌های متداول</h3>

                <div class="ttm-doc-qa">
                    <h4>چطور عضو جدید اضافه کنم؟</h4>
                    <p>از صفحه جزئیات تیم، دعوتنامه را ارسال کنید. پس از پذیرش کاربر، او عضو تیم می‌شود.</p>
                </div>
                <div class="ttm-doc-qa">
                    <h4>اگر مالک تیم باشم، می‌توانم آن را ترک کنم؟</h4>
                    <p>خیر. مالک نمی‌تواند تیم خود را ترک کند.</p>
                </div>
                <div class="ttm-doc-qa">
                    <h4>ددلاین چه معنایی دارد؟</h4>
                    <p>ددلاین مهلت پایان وظیفه است. اگر تا آن زمان وظیفه بسته نشده باشد، سامانه آن را با شکست در ددلاین می‌بندد.</p>
                </div>
                <div class="ttm-doc-qa">
                    <h4>دعوتنامه را اشتباهی رد کردم، چه کنم؟</h4>
                    <p>از مالک یا سرپرستی که دعوت را فرستاده بخواهید دعوت تازه‌ای ارسال کند.</p>
                </div>
                <div class="ttm-doc-qa">
                    <h4>شناسه تیم را کجا پیدا کنم؟</h4>
                    <p>در صفحه جزئیات تیم، دکمه «شناسه تیم» را بزنید تا در کلیپ‌بورد کپی شود.</p>
                </div>
            </section>

