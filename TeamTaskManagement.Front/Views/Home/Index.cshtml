@* ── Task lifecycle ── *@
<section class="mb-5">
    <div class="text-center mb-4">
        <h2 class="ttm-section-title mb-1">چرخه کار با وظیفه</h2>
        <p class="ttm-section-sub mb-0">هر وظیفه از ایجاد تا بستن، با تأیید در هر مرحله</p>
    </div>

    <ol class="ttm-flow">
        <li>
            <span class="ttm-step-num">۱</span>
            <div>
                <h3 class="h6 mb-1">ایجاد و واگذاری</h3>
                <p class="text-muted small mb-0">سرپرست وظیفه را می‌سازد و مسئول انجام آن را تعیین می‌کند.</p>
            </div>
        </li>
        <li>
            <span class="ttm-step-num">۲</span>
            <div>
                <h3 class="h6 mb-1">شروع و اعلام نتیجه</h3>
                <p class="text-muted small mb-0">مسئول کار را شروع می‌کند و در پایان، تکمیل یا شکست آن را اعلام می‌کند.</p>
            </div>
        </li>
        <li>
            <span class="ttm-step-num">۳</span>
            <div>
                <h3 class="h6 mb-1">تأیید یا تلاش مجدد</h3>
                <p class="text-muted small mb-0">سرپرست وظیفه را می‌بندد یا در صورت نیاز درخواست تلاش مجدد می‌دهد.</p>
            </div>
        </li>
    </ol>
</section>

@* ── Closing CTA ── *@
<section class="ttm-cta-band text-center mb-2">
    @if (isAuthenticated) {
        <h2 class="ttm-section-title mb-2">ادامه کار با تیم خود</h2>
        <p class="ttm-section-sub mb-3">وظایف باز و دعوتنامه‌های منتظر را از داشبورد بررسی کنید.</p>
        <div class="d-grid d-sm-inline-flex gap-2 justify-content-center">
            <a href="/Teams" class="btn-ttm-primary"><i class="bi bi-arrow-left"></i> به داشبورد بروید</a>
            <a href="/Home/Docs" class="btn-ttm-ghost"><i class="bi bi-book"></i> مستندات</a>
            <a href="@repoUrl" target="_blank" rel="noopener noreferrer" class="btn-ttm-ghost"><i class="bi bi-github"></i> مخزن GitHub</a>
        </div>
    }
    else {
        <h2 class="ttm-section-title mb-2">همین حالا شروع کنید</h2>
        <p class="ttm-section-sub mb-3">در چند دقیقه تیم خود را بسازید و اولین وظیفه را تعریف کنید.</p>
        <div class="d-grid d-sm-inline-flex gap-2 justify-content-center">
            <a href="/SignIn" class="btn-ttm-primary"><i class="bi bi-person-check"></i> ورود / ثبت‌نام</a>
            <a href="/Home/Docs" class="btn-ttm-ghost"><i class="bi bi-book"></i> مستندات</a>
            <a href="@repoUrl" target="_blank" rel="noopener noreferrer" class="btn-ttm-ghost"><i class="bi bi-github"></i> مخزن GitHub</a>
        </div>
    }
</section>