// این رشته اتصال و سکرت فقط روی لوکاله(محیط توسعه) و تو
// محیط پروداکشن مستقیما از متغیر های خود هاست برمیداره

/*
  روی هاست، باید 
  environmentVariables
  رو روی مقادیر واقعی تنظیم کنین تا مشکلی پیش نیاد
  چیزی مثل موارد زیر، کافیه کلوشه هارو با مقادیر
  گفته شده جایگزین کنین

ASPNETCORE_ENVIRONMENT=Production

ConnectionStrings__DefaultConnection=Server=[آدرس هاست];Database=[نام دیتابیس];User Id=[نام کاربری];Password=[رمزعبور];TrustServerCertificate=True;MultipleActiveResultSets=true

Jwt__SecretKey=[یه کلید خصوصی حداقل سی و دو کاراکتری]
Jwt__Issuer=[نام برند یا دامین یا دلخواه خودتون]
Jwt__Audience=[نام برند یا دامین یا دلخواه خودتون].Client
Jwt__ExpirationMinutes=60

*/
